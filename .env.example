# --- wol-launcher-notifier configuration ---
# Copy to .env and adjust. All values have sane defaults.

# Port the HTTP server listens on (behind your reverse proxy / DuckDNS).
PORT=8090

# Bind address. 127.0.0.1 when fronted by nginx/caddy on the same VM; 0.0.0.0 to expose directly.
HOST=0.0.0.0

# How often (minutes) to re-poll GitHub and rebuild the manifest.
# 10 min keeps a single VM well under GitHub's 60 req/h-per-IP anonymous budget
# even while tracking a handful of mods + their translation repos.
POLL_INTERVAL_MINUTES=10

# Path to the tracked-mods config (see mods.config.example.json).
MODS_CONFIG=./mods.config.json

# OPTIONAL: a GitHub personal access token (classic, no scopes needed for public
# repos) lifts the anonymous 60 req/h limit to 5000 req/h for this VM's IP. Leave
# empty to poll anonymously. The token never leaves the server — the manifest the
# launchers read carries only public version/translation data.
GITHUB_TOKEN=
