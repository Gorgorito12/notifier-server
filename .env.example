# --- wol-launcher-notifier configuration ---
# Copy to .env and adjust. All values have sane defaults.

# Port the HTTP server listens on (behind your reverse proxy / DuckDNS).
PORT=8090

# Bind address. 127.0.0.1 when fronted by nginx/caddy on the same VM; 0.0.0.0 to expose directly.
HOST=0.0.0.0

# How often (minutes) to re-poll GitHub and rebuild the manifest.
# 10 min keeps a single VM well under GitHub's 60 req/h-per-IP anonymous budget
# even while tracking a handful of mods + their translation repos.
POLL_INTERVAL_MINUTES=10

# PRIMARY source. The mods catalog repo ("owner/repo"). The poller auto-discovers
# every mod from here (reading each mod.json) — so a modder only publishes to the
# catalog and notifications "just work"; nobody hand-maintains this server.
# Default matches the launcher's built-in catalog.
CATALOG_REPO=Gorgorito12/aoe3-mods-catalog

# OPTIONAL per-mod overrides, merged on top of the catalog by id (see
# mods.config.example.json). Normally absent — the catalog is enough. Only for
# edge cases (a mod not in the catalog, or forcing a different URL).
MODS_CONFIG=./mods.config.json

# OPTIONAL: a GitHub personal access token (classic, no scopes needed for public
# repos) lifts the anonymous 60 req/h limit to 5000 req/h for this VM's IP. Leave
# empty to poll anonymously. The token never leaves the server — the manifest the
# launchers read carries only public version/translation data.
GITHUB_TOKEN=

# --- Announcements -----------------------------------------------------------
# Where the launcher's announcements file lives. Publishing one is a COMMIT to
# that file — no deploy, no SSH, editable from the GitHub web UI — and the next
# poll republishes it to every launcher.
#
# It is the LAUNCHER's repo, not the mods catalog: these are the launcher's own
# notices, not any mod's. Defaults below; you normally do not need to set these.
ANNOUNCEMENTS_REPO=
ANNOUNCEMENTS_PATH=
